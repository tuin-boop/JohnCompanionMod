Class FriendTauntHandler : EventHandler
{
	Override Void WorldLoaded(WorldEvent e)
	{
		// Preserve the counter when loading a save or reopening a hub map.
		if (e.IsSaveGame || e.IsReopen) return;
		for (int i = 0; i < MAXPLAYERS; i++)
		{
			if (playeringame[i] && players[i].mo)
			{
				players[i].mo.TakeInventory("NNR_JohnKillCounter", 2147483647);
				players[i].mo.TakeInventory("NNR_JohnLevelKillCounter", 2147483647);
                players[i].mo.TakeInventory("NNR_CarmackLevelKillCounter", 2147483647);
                players[i].mo.TakeInventory("NNR_CarmackKillCounter", 2147483647);
                players[i].mo.TakeInventory("NNR_JayLevelKillCounter", 2147483647);
                players[i].mo.TakeInventory("NNR_TomLevelKillCounter", 2147483647);
                players[i].mo.TakeInventory("NNR_AdrianLevelKillCounter", 2147483647);
                players[i].mo.TakeInventory("NNR_ExtraLevelKillCounter",2147483647);
 players[i].mo.TakeInventory("NNR_TinaLevelKillCounter",2147483647);
 players[i].mo.TakeInventory("NNR_KarinLevelKillCounter",2147483647);
 players[i].mo.TakeInventory("NNR_FrierLevelKillCounter",2147483647);
 players[i].mo.TakeInventory("NNR_TuinLevelKillCounter",2147483647);
 players[i].mo.TakeInventory("NNR_EstherLevelKillCounter",2147483647);
 players[i].mo.TakeInventory("NNR_KumiLevelKillCounter",2147483647);

				int previousFact = players[i].mo.CountInv("NNR_JohnFactToken");
				int nextFact = Random(1, 100);
				if (nextFact == previousFact)
					nextFact = (nextFact % 100) + 1;
				players[i].mo.TakeInventory("NNR_JohnFactToken", 100);
				players[i].mo.GiveInventory("NNR_JohnFactToken", nextFact);
			}
		}
	}

	Override Void WorldThingDied(WorldEvent e)
	{
		Let victim = e.Thing;
		Let source = e.Thing.Target;
		NNR_JohnMarine john = NNR_JohnMarine(source);
		If (!john && source && source.Target is "NNR_JohnMarine")
		{
			john = NNR_JohnMarine(source.Target);
		}
		If((victim.bISMONSTER || victim.bCOUNTKILL) && john)
		{
			If(john.Health > 0)			
			{
				if (john.Master && john.Master.Player)
				{
					if (john.Member()>=6) john.Master.GiveInventory(NNR_Team.Counter(john.Member()),1);
                    else if (john.IsAdrian()) john.Master.GiveInventory("NNR_AdrianLevelKillCounter",1);
                    else if (john.IsTom()) john.Master.GiveInventory("NNR_TomLevelKillCounter",1);
                    else if (john.IsJay()) john.Master.GiveInventory("NNR_JayLevelKillCounter",1);
                    else if (john.IsCarmack())
                    {
                        john.Master.GiveInventory("NNR_CarmackKillCounter", 1);
                        john.Master.GiveInventory("NNR_CarmackLevelKillCounter", 1);
                    }
                    else
                    {
                        john.Master.GiveInventory("NNR_JohnKillCounter", 1);
                        john.Master.GiveInventory("NNR_JohnLevelKillCounter", 1);
                    }
				}
                let chat=NNR_CompanionBanter(EventHandler.Find("NNR_CompanionBanter"));
                if(chat)chat.OnKill(john,victim,e.Inflictor);
				If(Random(0,100) <= 25 || Victim.bBOSS) 
				{ 
					john.A_RomeroVoice("yohn/laugh", CHAN_VOICE, CHANF_DEFAULT, 1, ATTN_NONE);
				}
			}
		}
	}
}

Class NNR_JohnHUDHandler : EventHandler
{
	ui int FaceFrame;
	ui int FaceTicks;
	ui int FaceSeed;
	ui int LastFact;
	ui int FactDelay;
	ui int FactTicks;

	Override void UiTick()
	{
		if (consoleplayer >= 0 && players[consoleplayer].mo)
		{
			int currentFact = players[consoleplayer].mo.CountInv("NNR_JohnFactToken");
			if (currentFact > 0 && currentFact != LastFact)
			{
				LastFact = currentFact;
				FactDelay = 70;
				FactTicks = 420;
			}
			if (FactDelay > 0) FactDelay--;
			else if (FactTicks > 0) FactTicks--;
		}

		if (FaceSeed == 0)
		{
			FaceFrame = 1;
			FaceTicks = 175;
			FaceSeed = 17321;
		}
		FaceTicks--;
		if (FaceTicks > 0) return;

		FaceSeed = (FaceSeed * 1103515245 + 12345) & 0x7fffffff;
		if (FaceFrame == 1)
		{
			FaceFrame = ((FaceSeed >> 8) & 1) == 0 ? 0 : 2;
			FaceTicks = 10 + ((FaceSeed >> 16) % 16);
		}
		else
		{
			FaceFrame = 1;
			FaceTicks = 175 + ((FaceSeed >> 12) % 246);
		}
	}


    ui void DrawJayHud(int y)
    {
            Screen.DrawTexture(TexMan.CheckForTexture(FaceFrame==0?"JAYLEFT":FaceFrame==2?"JAYRIGHT":"JAYFACE",TexMan.Type_Any),false,584,y,
                DTA_VirtualWidth,640,DTA_VirtualHeight,360,DTA_DestWidth,46,DTA_DestHeight,49,DTA_LeftOffset,0,DTA_TopOffset,0,DTA_KeepRatio,true);
            String jayKills=String.Format("JAY  KILLS: %d",players[consoleplayer].mo.CountInv("NNR_JayLevelKillCounter"));
            Screen.DrawText(SmallFont,Font.CR_GOLD,632-SmallFont.StringWidth(jayKills),y+52,jayKills,
                DTA_VirtualWidth,640,DTA_VirtualHeight,360,DTA_KeepRatio,true);
    }
	Override void RenderOverlay(RenderEvent e)
	{
        if (!CVar.FindCVar("blnk_companionhud").GetBool()) return;
        if (level.MapName=="TITLEMAP") return;
        if(CVar.FindCVar("blnk_companions").GetInt()==6)return;
        if (Menu.GetCurrentMenu() is "NNR_CompanionPreviewMenu") return;
		if (consoleplayer < 0 || !players[consoleplayer].mo) return;

        int mode=CVar.FindCVar("blnk_companions").GetInt();
        for(int slot=0;slot<2;slot++){
            int member=NNR_Team.Slot(mode,slot);if(!member)continue;int y=6+76*slot;
            Screen.DrawTexture(TexMan.CheckForTexture(NNR_Team.Face(member,FaceFrame),TexMan.Type_Any),false,584,y,DTA_VirtualWidth,640,DTA_VirtualHeight,360,DTA_DestWidth,46,DTA_DestHeight,49,DTA_LeftOffset,0,DTA_TopOffset,0,DTA_KeepRatio,true);
            String text=String.Format("%s  KILLS: %d",NNR_Team.Name(member),players[consoleplayer].mo.CountInv(NNR_Team.Counter(member)));
            Screen.DrawText(SmallFont,Font.CR_GOLD,632-SmallFont.StringWidth(text),y+52,text,DTA_VirtualWidth,640,DTA_VirtualHeight,360,DTA_KeepRatio,true);
        }
        bool carmack=(NNR_Team.Mask(mode)&1)==0;
		CVar factsEnabled = CVar.FindCVar("blnk_mapfacts");
		if (!carmack && factsEnabled && factsEnabled.GetBool() && LastFact > 0 && FactDelay <= 0 && FactTicks > 0)
		{
			String heading = "JOHN'S GAME FACT";
			int headingX = 300 - SmallFont.StringWidth(heading) / 2;
			Screen.DrawText(SmallFont, Font.CR_BLACK, headingX + 1, 78 + 1, heading,
				DTA_VirtualWidth, 640, DTA_VirtualHeight, 360, DTA_KeepRatio, true);
			Screen.DrawText(SmallFont, Font.CR_GOLD, headingX, 78, heading,
				DTA_VirtualWidth, 640, DTA_VirtualHeight, 360, DTA_KeepRatio, true);

			String fact = NNR_JohnFacts.GetFact(LastFact);
			BrokenLines lines = SmallFont.BreakLines(fact, 440);
			for (int line = 0; line < lines.Count(); line++)
			{
				int lineX = 300 - lines.StringWidth(line) / 2;
				int lineY = 90 + line * 9;
				Screen.DrawText(SmallFont, Font.CR_BLACK, lineX + 1, lineY + 1, lines.StringAt(line),
					DTA_VirtualWidth, 640, DTA_VirtualHeight, 360, DTA_KeepRatio, true);
				Screen.DrawText(SmallFont, Font.CR_WHITE, lineX, lineY, lines.StringAt(line),
					DTA_VirtualWidth, 640, DTA_VirtualHeight, 360, DTA_KeepRatio, true);
			}
		}
	}
}

Class NNR_JohnMainMenu : ListMenu
{
	Override void Init(Menu parent, ListMenuDescriptor desc)
	{
		Super.Init(parent, desc);
        // Add-ons may append items with an explicit Position already used by
        // another mod. Reflow selectable rows, including their mouse hitboxes.
        int rows=0;double top=200;
        for(int i=0;i<desc.mItems.Size();i++)
            if(desc.mItems[i].Selectable()){rows++;top=Min(top,desc.mItems[i].GetY());}
        if(rows>0)
        {
            double spacing=16;
            top=Min(top,184-rows*spacing);
            int row=0;
            for(int i=0;i<desc.mItems.Size();i++)
                if(desc.mItems[i].Selectable())desc.mItems[i].SetY(top+(row++)*spacing);
        }

		DontDim = true;
		DontBlur = true;
	}

	Override void Drawer()
	{
		if (level.MapName=="TITLEMAP") { Super.Drawer();return; }
        TextureID background = TexMan.CheckForTexture("JMENUBG", TexMan.Type_Any);
		Screen.DrawTexture(background, false, 0, 0,
			DTA_DestWidth, Screen.GetWidth(),
			DTA_DestHeight, Screen.GetHeight(),
			DTA_LeftOffset, 0,
			DTA_TopOffset, 0,
			DTA_KeepRatio, false);
		Super.Drawer();
	}
}



