// Doom single-player tally screen with John's per-level contribution.
class NNR_JohnStatusScreen : DoomStatusScreen
{
	int JohnKills;
    int CarmackKills;
    int JayKills;int TomKills;int AdrianKills;int ExtraKills;int TinaKills;int KarinKills;
	int FaceFrame;
	int FaceTicks;
	int FaceSeed;
	String JohnRemark;

	void PickRemark()
	{
		int pick = (JohnKills * 17 + wbs.totaltime) % 3;

		if (JohnKills <= 0)
		{
			JohnRemark = pick == 0 ? "I WAS SUPERVISING." :
				pick == 1 ? "YOU HAD THAT ONE COVERED." : "I'LL GET THE NEXT MAP.";
		}
		else if (wbs.maxkills > 0 && JohnKills * 2 >= wbs.maxkills)
		{
			JohnRemark = pick == 0 ? "I CALL THAT QUALITY ASSURANCE." :
				pick == 1 ? "YOU MISSED A FEW. I DIDN'T." : "THAT MAP HAS BEEN DEBUGGED.";
		}
		else if (JohnKills <= 3)
		{
			JohnRemark = pick == 0 ? "JUST GETTING WARMED UP." :
				pick == 1 ? "EVERY KILL COUNTS." : "A SOLID OPENING.";
		}
		else if (JohnKills <= 9)
		{
			JohnRemark = pick == 0 ? "GOOD MAP. NEEDS MORE BARRELS." :
				pick == 1 ? "THAT LEVEL HAD IT COMING." : "NOT BAD FOR A COMPANION.";
		}
		else
		{
			JohnRemark = pick == 0 ? "THAT'S HOW YOU SHIP A LEVEL." :
				pick == 1 ? "YOU BUILD THEM. I BREAK THEM." : "ANOTHER MAP, CLEANED UP.";
		}
	}

	override void Start(wbstartstruct data)
	{
		Super.Start(data);
		JohnKills = 0;
        CarmackKills = 0;JayKills=0;TomKills=0;AdrianKills=0;ExtraKills=0;TinaKills=0;KarinKills=0;
		if (me >= 0 && me < MAXPLAYERS && players[me].mo)
		{
			JohnKills = players[me].mo.CountInv("NNR_JohnLevelKillCounter");
            CarmackKills = players[me].mo.CountInv("NNR_CarmackLevelKillCounter");
            JayKills=players[me].mo.CountInv("NNR_JayLevelKillCounter");TomKills=players[me].mo.CountInv("NNR_TomLevelKillCounter");AdrianKills=players[me].mo.CountInv("NNR_AdrianLevelKillCounter");ExtraKills=players[me].mo.CountInv("NNR_ExtraLevelKillCounter");TinaKills=players[me].mo.CountInv("NNR_TinaLevelKillCounter");KarinKills=players[me].mo.CountInv("NNR_KarinLevelKillCounter");
		}
		FaceFrame = 1;
		FaceTicks = 70;
		FaceSeed = 17321 + JohnKills * 97 + wbs.totaltime;
		PickRemark();
	}

	override void Ticker()
	{
		Super.Ticker();
		FaceTicks--;
		if (FaceTicks > 0) return;

		FaceSeed = (FaceSeed * 1103515245 + 12345) & 0x7fffffff;
		if (FaceFrame == 1)
		{
			FaceFrame = ((FaceSeed >> 8) & 1) == 0 ? 0 : 2;
			FaceTicks = 10 + ((FaceSeed >> 16) % 16);
		}
		else
		{
			FaceFrame = 1;
			FaceTicks = 70 + ((FaceSeed >> 12) % 106);
		}
	}

	override void drawStats(void)
	{
		Super.drawStats();
        if(CVar.FindCVar("blnk_companions").GetInt()==6)return;
		CVar enabled = CVar.FindCVar("blnk_intermission");
		if (enabled && !enabled.GetBool()) return;

        int mode=CVar.FindCVar("blnk_companions").GetInt();
        for(int slot=0;slot<2;slot++){
            int member=NNR_Team.Slot(mode,slot);if(!member)continue;int x=slot==0?2:272;int center=x+23;
            DrawTexture(TexMan.CheckForTexture(NNR_Team.Face(member,1,true),TexMan.Type_Any),x,50);
            String name=member==4?"TOM":member==3?"JAY":NNR_Team.Name(member);String kills=String.Format("%d KILLS",member==8?KarinKills:member==7?TinaKills:member==6?ExtraKills:member==5?AdrianKills:member==4?TomKills:member==3?JayKills:member==2?CarmackKills:JohnKills);
            DrawText(SmallFont,Font.CR_GOLD,center-SmallFont.StringWidth(name)/2,100,name,shadow:true);
            DrawText(SmallFont,Font.CR_GOLD,center-SmallFont.StringWidth(kills)/2,108,kills,shadow:true);
        }
        if(NNR_Team.Mask(mode)&1)DrawText(SmallFont,Font.CR_GOLD,160-SmallFont.StringWidth(JohnRemark)/2,196,JohnRemark,shadow:true);
    }
}
