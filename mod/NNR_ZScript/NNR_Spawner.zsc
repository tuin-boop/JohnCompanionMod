Class FriendSpawnHandler : EventHandler
{
    // Reconcile live selection, player respawns, saves, and map transitions.
    override void WorldTick()
    {
        if (level.MapName=="TITLEMAP") return;
        
        let mode = CVar.FindCVar("blnk_companions");
        if (mode.GetInt() < 0)
        {
            int oldSkin = CVar.FindCVar("blnk_bodyskin").GetInt();
            bool oldBoth = CVar.FindCVar("blnk_both").GetBool();
            if (!oldBoth)
            {
                if (oldSkin == 2 || (oldSkin == 4 || oldSkin == 5)) CVar.FindCVar("blnk_duocarmack").SetInt((oldSkin == 4 || oldSkin == 5) ? 1 : 0);
                else CVar.FindCVar("blnk_duoromero").SetInt(oldSkin);
            }
            mode.SetInt(oldBoth ? 2 : (oldSkin == 2 || (oldSkin == 4 || oldSkin == 5)) ? 1 : 0);
        }

        int selected=mode.GetInt();int mask=NNR_Team.Mask(selected);
        CVar.FindCVar("blnk_both").SetBool(selected==2);
        CVar.FindCVar("blnk_jay").SetBool((mask&4)!=0);
        CVar.FindCVar("blnk_bodyskin").SetInt(CVar.FindCVar("blnk_duoromero").GetInt());
        for(int i=0;i<MAXPLAYERS;i++)
        {
            if(!playeringame[i] || !players[i].mo || players[i].mo.health<=0)continue;
            int found=0;let it=ThinkerIterator.Create("NNR_JohnMarine");NNR_JohnMarine a;
            while((a=NNR_JohnMarine(it.Next()))!=null){if(a.master!=players[i].mo)continue;int bit=1<<(a.Member()-1);if(!(mask&bit) || (found&bit))a.Destroy();else found|=bit;}
            for(int slot=0;slot<2;slot++){
                int member=NNR_Team.Slot(selected,slot);if(!member || (found&(1<<(member-1))))continue;
                class<Actor> kind=member==5?"NNR_AdrianMarine":member==4?"NNR_TomMarine":member==3?"NNR_JayMarine":member==2?"NNR_CarmackMarine":"NNR_JohnMarine";
                if(member>=6){String extra=member==12?"NNR_KumiMarine":member==11?"NNR_EstherMarine":member==10?"NNR_TuinMarine":member==9?"NNR_FrierMarine":member==8?"NNR_KarinMarine":member==7?"NNR_TinaMarine":"NNR_HimikoMarine";kind=(class<Actor>)(extra);}
                let a=Actor.Spawn(kind,players[i].mo.pos);if(a){a.master=players[i].mo;a.Warp(a.master,-64,slot==0?-40:40,0,0,WARPF_STOP|WARPF_TOFLOOR);a.A_FaceMaster();}
            }
        }
    }
    void SpawnFriend(Actor pl, bool carmack)
    {
        Actor a;
        if (carmack) a = Actor.Spawn("NNR_CarmackMarine", pl.pos);
        else a = Actor.Spawn("NNR_JohnMarine", pl.pos);
        if (!a) return;
        a.Master = pl;
        a.Translation = pl.Translation;
        a.Warp(pl, -56, carmack ? 40 : -40, 0, 0, WARPF_STOP | WARPF_TOFLOOR);
        a.A_FaceMaster();
    }
}
