Class FriendSpawnHandler : EventHandler
{
    // Reconcile live selection, player respawns, saves, and map transitions.
    override void WorldTick()
    {
        if (level.MapName=="TITLEMAP") return;
        
        let mode = CVar.FindCVar("blnk_companions");
        if (mode.GetInt() < 0)
        {
            int oldSkin = CVar.FindCVar("blnk_bodyskin").GetInt();
            bool oldBoth = CVar.FindCVar("blnk_both").GetBool();
            if (!oldBoth)
            {
                if (oldSkin == 2 || (oldSkin == 4 || oldSkin == 5)) CVar.FindCVar("blnk_duocarmack").SetInt((oldSkin == 4 || oldSkin == 5) ? 1 : 0);
                else CVar.FindCVar("blnk_duoromero").SetInt(oldSkin);
            }
            mode.SetInt(oldBoth ? 2 : (oldSkin == 2 || (oldSkin == 4 || oldSkin == 5)) ? 1 : 0);
        }

        bool duo = mode.GetInt() == 2;
        CVar.FindCVar("blnk_jay").SetBool(mode.GetInt() >= 3);
        if (CVar.FindCVar("blnk_both").GetBool() != duo) CVar.FindCVar("blnk_both").SetBool(duo);
        int skin = (mode.GetInt() == 1 || mode.GetInt() == 5) ? (CVar.FindCVar("blnk_duocarmack").GetInt() == 2 ? 5 : CVar.FindCVar("blnk_duocarmack").GetInt() == 1 ? 4 : 2) : CVar.FindCVar("blnk_duoromero").GetInt();
        if (CVar.FindCVar("blnk_bodyskin").GetInt() != skin) CVar.FindCVar("blnk_bodyskin").SetInt(skin);
bool both = CVar.FindCVar("blnk_both").GetBool();
        for (int i = 0; i < MAXPLAYERS; i++)
        {
            if (!playeringame[i] || !players[i].mo || players[i].mo.health <= 0) continue;
            Actor pl = players[i].mo;
            NNR_JohnMarine romero;
            NNR_JohnMarine carmack;
            NNR_JohnMarine jay;
            let it = ThinkerIterator.Create("NNR_JohnMarine");
            NNR_JohnMarine a;
            while ((a = NNR_JohnMarine(it.Next())) != null)
            {
                if (a.Master != pl) continue;
                if (a.IsJay())
                {
                    if (!CVar.FindCVar("blnk_jay").GetBool() || jay) a.Destroy();
                    else jay=a;
                }
                else if (a is "NNR_CarmackMarine")
                {
                    if (!both || carmack) a.Destroy();
                    else carmack = a;
                }
                else
                {
                    if (mode.GetInt()==3 || romero) a.Destroy();
                    else romero = a;
                }
            }
            if (CVar.FindCVar("blnk_jay").GetBool() && !jay)
            {
                let j=Actor.Spawn("NNR_JayMarine",pl.pos);
                if(j) { j.Master=pl;j.Warp(pl,-96,0,0,0,WARPF_STOP|WARPF_TOFLOOR);j.A_FaceMaster(); }
            }
            if (mode.GetInt()!=3 && !romero) SpawnFriend(pl, false);
            if (both && !carmack) SpawnFriend(pl, true);
        }
    }
    void SpawnFriend(Actor pl, bool carmack)
    {
        Actor a;
        if (carmack) a = Actor.Spawn("NNR_CarmackMarine", pl.pos);
        else a = Actor.Spawn("NNR_JohnMarine", pl.pos);
        if (!a) return;
        a.Master = pl;
        a.Translation = pl.Translation;
        a.Warp(pl, -56, carmack ? 40 : -40, 0, 0, WARPF_STOP | WARPF_TOFLOOR);
        a.A_FaceMaster();
    }
}
