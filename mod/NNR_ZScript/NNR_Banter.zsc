// Original fictional game banter, inspired by interviews; not authentic quotes.
class NNR_CompanionBanter : EventHandler
{
 int NextLine[MAXPLAYERS];int NextIdle[MAXPLAYERS];int PersonalReady[MAXPLAYERS*3];
 int LastChoice[MAXPLAYERS*3*25];String Message[MAXPLAYERS];int MessageUntil[MAXPLAYERS];int Speaker[MAXPLAYERS];
 bool Introduced[MAXPLAYERS];
