 }
 static int EnemyCategory(Actor victim)
 {
  if(victim is "Cyberdemon")return 5;
  if(victim is "SpiderMastermind")return 6;
  if(victim is "Archvile")return 7;
  if(victim is "Revenant")return 8;
  if(victim is "Cacodemon")return 9;
  if(victim is "Demon" || victim is "Spectre")return 10;
  if(victim is "DoomImp")return 4;
  if(victim.bBOSS)return 24;
  return 3;
 }
 static int WeaponCategory(NNR_JohnMarine john,Actor inflictor)
 {
  // Use the projectile that hit, even if its owner has since switched weapons.
  if(inflictor is "FriendRocketProjectile")return 14;
  if(inflictor is "FriendPlasmaBall")return 15;
  if(inflictor is "FriendBFGBall")return 16;
  if(inflictor is "NNR_DKHammerShockwave")return 18;
  if(inflictor is "NNR_DKDiscusProjectile" || inflictor is "NNR_DKDiscusSpark")return 19;
  if(inflictor is "NNR_DKVenomProjectile" || inflictor is "NNR_DKVenomPuff")return 20;
  if(inflictor is "NNR_DKTridentProjectile" || inflictor is "NNR_DKTridentShockwave")return 21;
  if(inflictor is "NNR_DKSunflareProjectile" || inflictor is "NNR_DKEmber")return 22;
  if(inflictor is "NNR_DKZeusProjectile" || inflictor is "NNR_DKZeusTracer")return 23;
  return john.LastWeaponCategory;
 }
 bool Say(NNR_JohnMarine john,int category)
 {
  if(!CVar.FindCVar("blnk_banter").GetBool() || !john || !john.master || !john.master.player || john.health<=0 || !john.bSHOOTABLE)return false;
  int who=john.master.PlayerNumber();if(who<0 || who>=MAXPLAYERS)return false;
  int member=john.IsJay()?2:john.IsCarmack()?1:0;
  if(level.time<NextLine[who] || level.time<PersonalReady[who*3+member])return false;
  // Do not place text chatter on top of a long interview/voice clip.
  if(john.CompanionVoiceBusy())return false;
  int key=(who*3+member)*25+category;
  int variant=Random[NNRBanter](0,1);
  if(LastChoice[key]==variant+1)variant=1-variant;
  LastChoice[key]=variant+1;
  Message[who]=Line(member,category,variant);Speaker[who]=member;MessageUntil[who]=level.time+245;
  NextLine[who]=level.time+Random[NNRBanter](30,50)*35;
  PersonalReady[who*3+member]=level.time+75*35;
  NextIdle[who]=level.time+Random[NNRBanter](90,150)*35;
  return true;
 }
 void OnKill(NNR_JohnMarine john,Actor victim,Actor inflictor)
 {
  if(!victim || victim.bFRIENDLY || !victim.bISMONSTER)return;
  int enemy=EnemyCategory(victim);
  bool boss=enemy==5 || enemy==6 || enemy==24;
  if(Random[NNRBanter](0,99)>=(boss?85:12))return;
  int category=enemy;
  if(!boss && Random[NNRBanter](0,99)<40)
  {
   int weapon=WeaponCategory(john,inflictor);
   if(weapon>=11 && weapon<=23)category=weapon;
  }
  Say(john,category);
 }
 override void WorldTick()
 {
  if(level.MapName=="TITLEMAP" || level.time%35!=0)return;
  for(int who=0;who<MAXPLAYERS;who++)
  {
   if(!playeringame[who] || !players[who].mo || players[who].mo.health<=0)continue;
   if(level.time<NextIdle[who] || level.time<NextLine[who])continue;
   if(level.time<350)continue;
   NextIdle[who]=level.time+35*15;
   NNR_JohnMarine selected;let it=ThinkerIterator.Create("NNR_JohnMarine");NNR_JohnMarine a;int count=0;
   while((a=NNR_JohnMarine(it.Next()))!=null)
   {
    if(a.master!=players[who].mo || !a.bSHOOTABLE || a.health<=0 || a.Distance3D(a.master)>2048)continue;
    if(a.CombatTarget(a.target) || level.time-a.LastShotTime<175)continue;
    int member=a.IsJay()?2:a.IsCarmack()?1:0;
    if(level.time<PersonalReady[who*3+member])continue;
    count++;if(Random[NNRBanter](1,count)==1)selected=a;
   }
   if(selected && Say(selected,Introduced[who]?(selected.Camping?2:1):0))Introduced[who]=true;
  }
 }
 override void RenderOverlay(RenderEvent e)
 {
  if(level.MapName=="TITLEMAP" || Menu.GetCurrentMenu()!=null || !CVar.FindCVar("blnk_banter").GetBool())return;
  int who=consoleplayer;if(who<0 || who>=MAXPLAYERS || level.time>=MessageUntil[who])return;
  int member=Speaker[who];int team=CVar.FindCVar("blnk_companions").GetInt();
  if(member==0 && team!=0 && team!=2 && team!=4)return;
  if(member==1 && team!=1 && team!=2 && team!=5)return;
  if(member==2 && team<3)return;
  String name=member==2?"JAY WILBUR":member==1?"CARMACK":"ROMERO";
  int color=member==2?Font.CR_GOLD:member==1?Font.CR_LIGHTBLUE:Font.CR_GREEN;
  double alpha=Min(1.,(MessageUntil[who]-level.time)/35.0);
  Screen.DrawText(SmallFont,color,8,18,String.Format("%s:",name),DTA_VirtualWidth,640,DTA_VirtualHeight,360,DTA_KeepRatio,true,DTA_Alpha,alpha);
  let lines=SmallFont.BreakLines(Message[who],390);
  for(int i=0;i<lines.Count();i++)
  {
   Screen.DrawText(SmallFont,Font.CR_BLACK,9,29+i*9,lines.StringAt(i),DTA_VirtualWidth,640,DTA_VirtualHeight,360,DTA_KeepRatio,true,DTA_Alpha,alpha);
   Screen.DrawText(SmallFont,Font.CR_WHITE,8,28+i*9,lines.StringAt(i),DTA_VirtualWidth,640,DTA_VirtualHeight,360,DTA_KeepRatio,true,DTA_Alpha,alpha);
  }
 }
}
