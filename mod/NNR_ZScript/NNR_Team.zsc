class NNR_Team : Object
{
 static int Mask(int mode){switch(mode){case 0:return 1;case 1:return 2;case 2:return 3;case 3:return 4;case 4:return 5;case 5:return 6;case 7:return 8;case 8:return 9;case 9:return 10;case 10:return 12;}return 0;}
 static int Mode(int mask){switch(mask){case 1:return 0;case 2:return 1;case 3:return 2;case 4:return 3;case 5:return 4;case 6:return 5;case 8:return 7;case 9:return 8;case 10:return 9;case 12:return 10;}return 6;}
 static int Slot(int mode,int slot){int mask=Mask(mode);for(int m=1;m<=4;m++)if(mask & (1<<(m-1))){if(slot==0)return m;slot--;}return 0;}
 static String Name(int member){return member==4?"TOM HALL":member==3?"JAY WILBUR":member==2?"CARMACK":member==1?"ROMERO":"NO COMPANION";}
 static String Counter(int member){return member==4?"NNR_TomLevelKillCounter":member==3?"NNR_JayLevelKillCounter":member==2?"NNR_CarmackLevelKillCounter":"NNR_JohnLevelKillCounter";}
 static String Face(int member,int frame,bool tally=false){
 if(member==4 && CVar.FindCVar("blnk_tomskin").GetInt()!=0)return tally?"TMPFACE":frame==0?"TMPLEFT":frame==2?"TMPRIGHT":"TMPFACE";
 if(member==4)return tally?"TOMFACE":frame==0?"TOMLEFT":frame==2?"TOMRIGHT":"TOMFACE";
 if(member==3)return tally?"JAYFACE":frame==0?"JAYLEFT":frame==2?"JAYRIGHT":"JAYFACE";
 if(member==2)return frame==0?"CMLEFT":frame==2?"CMRIGHT":"CMCENTR";
 bool classic=CVar.FindCVar("blnk_hudstyle").GetBool();
 if(tally)return classic?"JICCENTR":"JIFCENTR";
 return classic?(frame==0?"JHCLEFT":frame==2?"JHCRIGHT":"JHCCENTR"):(frame==0?"JHFLEFT":frame==2?"JHFRIGHT":"JHFCENTR");
 }
}
