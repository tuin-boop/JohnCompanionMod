			A_AlertMonsters(0, AMF_TARGETEMITTER);
		}
		YOHN E 12;
		Goto See;
	DKZeus:
		TNT1 A 0 A_StartSound("zeuseye/select", CHAN_WEAPON);
		YOHN AAAABBBBCCCCDDDD 1 CompanionChase(NULL,NULL,CHF_FASTCHASE);
		YOHN E 3 A_FaceTarget;
		YOHN F 6 Bright
		{
			A_FaceTarget();
			IdleTic = 0;
