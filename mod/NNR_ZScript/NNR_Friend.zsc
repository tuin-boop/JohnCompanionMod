class NNR_JohnMarine : actor
{
	virtual bool IsCarmack()
    {
        return false;
    }
    virtual bool IsTom() { return false; }
    virtual int Member() { return IsTom()?4:IsJay()?3:IsCarmack()?2:1; }
    virtual bool IsJay() { return false; }
    int NextCarmackSpeech;
    int VoiceUntil;
    int LastCarmackClip;
    bool VoiceWasCarmack;
    bool CompanionVoiceBusy()
    {
        let it = ThinkerIterator.Create("NNR_JohnMarine");
        NNR_JohnMarine a;
        while ((a = NNR_JohnMarine(it.Next())) != null)
        {
            if (a != self && (a.VoiceUntil > level.time || a.IsActorPlayingSound(CHAN_VOICE))) return true;
        }
        return IsActorPlayingSound(CHAN_VOICE) || VoiceUntil > level.time;
    }
    void TryCarmackSpeech()
    {
        if (!IsCarmack() || !GetCVar("blnk_carmackvoice") || level.time < NextCarmackSpeech || CompanionVoiceBusy()) return;
        if (!bSHOOTABLE) return;
        int pick = Random(1,5);
        if (pick == LastCarmackClip) pick = (pick + Random(1,4) - 1) % 5 + 1;
        Sound clip;
        int duration;
        switch (pick)
        {
            case 1: clip="carmack/line1"; duration=2327; break;
case 2: clip="carmack/line2"; duration=1814; break;
case 3: clip="carmack/line3"; duration=1554; break;
case 4: clip="carmack/line4"; duration=2054; break;
case 5: clip="carmack/line5"; duration=2421; break;
        }
        LastCarmackClip = pick;
        VoiceUntil = level.time + duration;
        NextCarmackSpeech = VoiceUntil + Max(60, GetCVar("blnk_carmackpause"))*35;
        A_StartSound(clip, CHAN_VOICE, CHANF_DEFAULT, 1, ATTN_NONE);
    }
    void A_RomeroVoice(Sound sound, int channel = CHAN_VOICE, int flags = CHANF_DEFAULT, double volume = 1, double attenuation = ATTN_NORM)
    {
        if (IsJay() || IsTom()) return;
        if (IsCarmack())
        {
            // Full interviews fit idle/kill chatter, not a death reaction.
            if (sound == "yohn/laugh") TryCarmackSpeech();
            return;
        }
        if (!CompanionVoiceBusy()) A_StartSound(sound, channel, flags, volume, attenuation);
    }

    int LastShotTime;
    int LastWeaponCategory;
    int NextTargetScan;
    int VisibleThreats;
    bool CombatTarget(Actor a)
    {
        return a && a != self && a != master && a.bISMONSTER && a.bSHOOTABLE
            && !a.bFRIENDLY && !a.bDORMANT && a.health > 0;
    }
    void ScanForThreats()
    {
        bool quiet = level.time - LastShotTime >= 175;
        NextTargetScan = level.time + (quiet ? 8 : 35);
        VisibleThreats = 0;
        Actor best = null;
        double nearest = 2048;
        let it = ThinkerIterator.Create("Actor");
        Actor candidate;
        while ((candidate = Actor(it.Next())) != null)
        {
            if (!CombatTarget(candidate)) continue;
            double distance = Distance3D(candidate);
            if (distance > 2048 || !CheckSight(candidate)) continue;
            VisibleThreats++;
            if (distance < nearest) { nearest = distance; best = candidate; }
        }
        // Keep a good target during combat; replace stale/blocked targets,
        // or reconsider the nearest visible enemy after five seconds quiet.
        if (!CombatTarget(target) || !CheckSight(target) || quiet)
            target = best;
    }

    bool Camping;
    Vector3 CampSpot;
    Vector2 CampGoal;
    int NextCampWander;
    bool HoldsPosition() { return Camping || GetCVar("blnk_closefollow") != 0; }
    bool CampAt(Actor pl, Vector3 spot, bool testOnly=false)
    {
        if ((spot.XY-pl.pos.XY).Length() < radius+pl.radius+4) return false;
        int flags=WARPF_STOP|WARPF_ABSOLUTEPOSITION;
        if(testOnly) flags|=WARPF_TESTONLY;
        if(!Warp(pl,spot.X,spot.Y,spot.Z,0,flags))return false;
        if(testOnly)return true;
        NextTargetScan=0;
        Camping=true;CampSpot=pos;CampGoal=pos.XY;NextCampWander=level.time+175;
        vel.X=0;vel.Y=0;
        Spawn("TeleportFog",pos);
        return true;
    }
    bool CloseSettled;
    bool CloseFollowStep()
    {
        CloseSettled = false;
        if (!HoldsPosition() || !master || master.health <= 0) return false;
        if (!Camping && !CheckSight(master)) return true;
        double behind = master.radius + radius + 32;
        double side = NNR_Team.Slot(int(GetCVar("blnk_companions")),1)!=0 ? (NNR_Team.Slot(int(GetCVar("blnk_companions")),0)==Member()?-32:32) : 0;

        Vector2 forward = (cos(master.angle), sin(master.angle));
        Vector2 right = (-forward.Y, forward.X);
        Vector2 goal = master.pos.XY - forward * behind + right * side;
        if (Camping)
        {
            if (level.time >= NextCampWander)
            {
                double heading=FRandom(0,360),range=24;
                CampGoal=CampSpot.XY+(cos(heading),sin(heading))*range;
                NextCampWander=level.time+Random(140,245);
            }
            goal=CampGoal;
        }
        Vector2 delta = goal - pos.XY;
        double distance = delta.Length();
        if (distance <= 8) { CloseSettled=true; vel.X = 0;vel.Y = 0;return true; }
        Vector2 next = pos.XY + delta / distance * Min(4., distance);
        double clearance = master.radius + radius + 12;
        if ((next-master.pos.XY).Length() < clearance)
        {
            // Walk around the player instead of cutting through them.
            Vector2 away = pos.XY-master.pos.XY;
            double length = away.Length();
            if (length < 1) away = -forward; else away /= length;
            Vector2 tangent = (-away.Y,away.X);
            if (tangent dot delta < 0) tangent = -tangent;
            next = pos.XY + (away + tangent)*3;
        }
        angle = VectorAngle(delta.X,delta.Y);
        vel.X=0;vel.Y=0;
        TryMove(next, false);
        return true;
    }

    void CompanionChase(statelabel melee = '_a_chase_default', statelabel missile = '_a_chase_default', int flags = 0)
    {
        if (HoldsPosition()) { flags |= CHF_DONTMOVE;melee = null; }
        A_Chase(melee,missile,flags);
    }
    void CompanionVelocity(double x,double y,double z,int flags=0)
    {
        if (!HoldsPosition()) A_ChangeVelocity(x,y,z,flags);
    }
    void CompanionRecoil(double amount)
    {
        if (!HoldsPosition()) A_Recoil(amount);
    }

    Int TeleTic;	
	Int	IdleTic;
	Default
	{
		Monster;
		Health 200;
		Radius 16;
		Height 56;
		Mass 100;
		Speed 3;
		PainChance 160;
		Damage 0;
		XScale 1;
		YScale 1;
		-COUNTKILL
		+BOSS
		+LOOKALLAROUND
		+FLOORCLIP
		+FRIENDLY
		+NOTAUTOAIMED
		+SLIDESONWALLS
		+DONTMORPH
		+NOBLOCKMONST
		+QUICKTORETALIATE
		+NOICEDEATH
		+BUDDHA
		+AVOIDMELEE
		MaxStepHeight 48;
		MaxDropOffHeight 48;
		PainSound "FM/Pain";
		DamageFactor "BuildFriendDamage", 0;
		DamageFactor "FriendMarineDamage", 0;
	}
	override int TakeSpecialDamage(Actor inflictor, Actor source, int damage, Name damagetype)
	{
		if (source && (source.player || source is "NNR_JohnMarine"))
		{
			return 0;
		}
		return super.TakeSpecialDamage(inflictor, source, damage, damagetype);
	}
	Override Void PostBeginPlay()		
	{
		Super.PostBeginPlay();
        VoiceWasCarmack = IsCarmack();
        NextCarmackSpeech = level.time + 60*35;
		A_RomeroVoice("yohn/start", CHAN_VOICE, CHANF_DEFAULT, 1, ATTN_NONE);
		A_StartSound("FM/IntroSFX",CHAN_AUTO);
	}
	override void Tick() 
	{
		if (VoiceWasCarmack != IsCarmack())
        {
            A_StopSound(CHAN_VOICE);
            VoiceUntil = 0;
            NextCarmackSpeech = level.time + 60*35;
            VoiceWasCarmack = IsCarmack();
        }
        if (IsCarmack() && !GetCVar("blnk_carmackvoice"))
        {
            A_StopSound(CHAN_VOICE);
            VoiceUntil = 0;
        }
        Vector2 positionBeforeTick = pos.XY;
        if (HoldsPosition()) { vel.X=0;vel.Y=0; }
        if (!isFrozen() && master && health > 5 && bSHOOTABLE
            && !InStateSequence(curstate,FindState("FakeDeath")) && level.time >= NextTargetScan)
        {
            ScanForThreats();
            // Only wake idle/chase states: never cancel a windup, burst or pain.
            if (CombatTarget(target) && (InStateSequence(curstate,FindState("Spawn"))
                || InStateSequence(curstate,FindState("See"))
                || InStateSequence(curstate,FindState("Stand"))))
            {
                if (level.time - LastShotTime >= 175) SetStateLabel("Missile");
                else if (InStateSequence(curstate,FindState("Spawn"))) SetStateLabel("See");
            }
        }
        super.Tick();
        if (HoldsPosition() && master && bSHOOTABLE && !InStateSequence(curstate,FindState("FakeDeath")))
        {
            if (InStateSequence(curstate,FindState("Spawn"))) SetStateLabel("See");
            CloseFollowStep();
            if (target && target != master && !target.bFRIENDLY) A_FaceTarget();
        }
        // A-D are walking poses. Keep AI/state timing running, but show a
        // stable standing pose if collision or a camp order prevented movement.
        // Attack, pain and falling frames remain untouched.
        if (frame >= 0 && frame <= 3 && (pos.XY-positionBeforeTick).Length() < 0.01)
            frame = 0;
        // Appearance changes do not restart states or alter weapon behavior.
        if (sprite == GetSpriteIndex("YOHN") || sprite == GetSpriteIndex("JCLS") || sprite == GetSpriteIndex("JCMA") || sprite == GetSpriteIndex("JR05") || sprite == GetSpriteIndex("JC06") || sprite == GetSpriteIndex("SWMK") || sprite == GetSpriteIndex("JAYW") || sprite == GetSpriteIndex("TOMH") || sprite == GetSpriteIndex("TMPR"))
        {
            if (IsTom()) sprite = GetSpriteIndex(GetCVar("blnk_tomskin")!=0?"TMPR":"TOMH");
            else if (IsJay()) sprite = GetSpriteIndex("JAYW");
            else if (IsCarmack())
            {
                bool later = GetCVar("blnk_duocarmack") == 1;
                if (GetCVar("blnk_duocarmack") == 2) sprite = GetSpriteIndex("SWMK");
                else if (later) sprite = GetSpriteIndex("JC06");
                else sprite = GetSpriteIndex("JCMA");
            }
            else if ((GetCVar("blnk_both") != 0 ? GetCVar("blnk_duoromero") : GetCVar("blnk_bodyskin")) == 3) sprite = GetSpriteIndex("JR05");
            else if ((GetCVar("blnk_both") != 0 ? GetCVar("blnk_duoromero") : GetCVar("blnk_bodyskin")) == 1) sprite = GetSpriteIndex("JCLS");
            else sprite = GetSpriteIndex("YOHN");
        }

		if (isFrozen())
		{
			return;
		}
		if (!master)
		{
			Spawn("TeleportFog", (pos.x, pos.y, pos.z + height * 0.5));
			Destroy();
			return;
		}
		if (health < default.health)
		{
			A_SetHealth(health + 1);
		}
		if (health <= 5 && !InStateSequence(curstate, FindState("FakeDeath")))
		{
			A_SetHealth(default.health);
			SetStateLabel("FakeDeath");
		}
	}
	Override bool CanCollideWith(Actor other, bool Passive)
	{
		If(!Other) 
		Return False;
		If(Other && !Passive)
		{
			If(Other.Player)
			{
				If(!Deathmatch) 
				Return False;
				Else If(Deathmatch && Other == Master) 
				Return False;
			}			
			If(Other.bMISSILE && Other.Target && Other.Target.Player)
			{
				If(!Deathmatch) 
				Return False;
				Else If(Deathmatch && Other.Target == Master) 
				Return False;
			}			
			Return True;
		}
		If(Other && Passive)
		{
			If(Other.Player)
			{
				If(!Deathmatch) 
				Return False;
				Else If(Deathmatch && Other == Master) 
				Return False;
			}			
			If(Other.bMISSILE && Other.Target && Other.Target.Player)
			{
				If(!Deathmatch) 
				Return False;
				Else If(Deathmatch && Other.Target == Master) 
				Return False;
			}
			Return True;
		}
		Return True;
	}	
	States
	{
    Spawn:
		YOHN A 1 A_Look;
		TNT1 A 0 A_CheckSight("TeleTic");
		Loop;
	See:
		YOHN AAAABBBBCCCCDDDD 1
		{
			if (HoldsPosition()) { CompanionChase(Null,"Missile",CHF_NOPLAYACTIVE|CHF_DONTMOVE); Return ResolveState(Null); }
            If (Master && Distance3D(master) < 70)
			{
				Return ResolveState("Stand");
			}
			CompanionChase();
			CompanionRecoil(-1);
			Return ResolveState(Null);
		}
		TNT1 A 0 A_CheckSight("TeleTic");
		Loop;
	Stand:
		YOHN E 1
		{ 
			If (IdleTic >= GetCVar("blnk_idletalk"))
            {
                IdleTic = 0;
				A_RomeroVoice("yohn/laugh", CHAN_VOICE);
				//A_StartSound("FM/IntroSFX",CHAN_AUTO);
            }
            IdleTic++;
			CompanionChase(Null,"Missile",CHF_NOPLAYACTIVE|CHF_DONTMOVE);
		}
		Goto See;
	TeleTic:
        TNT1 A 0 
        {
            if (Camping) { teletic=0;return; }
            if (teletic >= 5)
            {
                A_ClearTarget();
				teletic = 0;
				Warp(master, frandom(-16, -64), frandom(-64, 64), 0, 0, WARPF_STOP|WARPF_TOFLOOR);
            }
			teletic++;
        }
        Goto See;
	Melee:
		TNT1 A 0 A_Jump(64,"Missile");
		YOHN A 2;
		TNT1 A 0
		{
			IdleTic = 0;
			A_FaceTarget();
			CompanionRecoil(-3);
		}
		YOHN E 6 A_CustomMeleeAttack(random(6,10),"FM/Punch");
		YOHN A 2;
		Goto See;
	Missile:
		TNT1 A 0
		{
            if (VisibleThreats > 15 && Random(0,99) < 80)
            {
                if (GetCVar("blnk_weaponstyle") != 0)
                {
                    int pick=Random(0,9);
                    if (pick < 2) return ResolveState("BFG");
                    // Prefer plasma instead of rockets at point-blank range.
                    if (pick < 5 && target && Distance3D(target) > 192) return ResolveState("Rocket");
                    return ResolveState("Plasma");
                }
                int pick=Random(0,3);
                if (pick == 0) return ResolveState("DKZeus");
                if (pick == 1) return ResolveState("DKSunflare");
                return ResolveState("DKTrident");
            }
			CVar weaponStyle = CVar.FindCVar("blnk_weaponstyle");
			if (weaponStyle && weaponStyle.GetInt() != 0)
			{
				return ResolveState("DoomMissile");
			}
			return ResolveState("DaikatanaMissile");
		}
	DaikatanaMissile:
        TNT1 A 0 A_JumpIf(HoldsPosition(),"CloseDKMissile");
		// Six normal attacks have equal weight; Eye of Zeus is about 3%.
		TNT1 A 0 A_Jump(256,
			"DKGlove", "DKHammer", "DKDiscus", "DKVenom", "DKTrident", "DKSunflare",
			"DKGlove", "DKHammer", "DKDiscus", "DKVenom", "DKTrident", "DKSunflare",
			"DKGlove", "DKHammer", "DKDiscus", "DKVenom", "DKTrident", "DKSunflare",
			"DKGlove", "DKHammer", "DKDiscus", "DKVenom", "DKTrident", "DKSunflare",
			"DKGlove", "DKHammer", "DKDiscus", "DKVenom", "DKTrident", "DKSunflare",
			"DKZeus");
		Goto DKGlove;
	DoomMissile:
		// Doom BFG is rare; the other five weapons are evenly weighted.
		TNT1 A 0 A_Jump(256,
			"Shotgun", "SuperShotgun", "Chaingun", "Rocket", "Plasma",
			"Shotgun", "SuperShotgun", "Chaingun", "Rocket", "Plasma",
			"Shotgun", "SuperShotgun", "Chaingun", "Rocket", "Plasma",
			"Shotgun", "SuperShotgun", "Chaingun", "Rocket", "Plasma",
			"Shotgun", "SuperShotgun", "Chaingun", "Rocket", "Plasma",
			"Shotgun", "SuperShotgun", "Chaingun", "Rocket", "Plasma",
			"BFG");
		Goto Shotgun;
	CloseDKMissile:
        TNT1 A 0 A_Jump(256,"DKDiscus","DKVenom","DKTrident","DKSunflare","DKZeus");
        Goto DKVenom;
	DKGlove:
		YOHN E 2 A_FaceTarget;
		YOHN F 2 Bright
		{
			A_FaceTarget();
			IdleTic = 0;
			A_StartSound("glove/fire", CHAN_WEAPON);
            LastWeaponCategory = 17;
			A_CustomMeleeAttack(random(6,10), "glove/hit");
			A_AlertMonsters(0, AMF_TARGETEMITTER);
		}
		YOHN E 5;
		Goto See;
	DKHammer:
