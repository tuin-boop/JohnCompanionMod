		}
		YOHN F 6 CompanionVelocity(random(2,10), random(-10,10), random(1,2),CVF_RELATIVE);
		YOHN E 1;
		YOHN AAAABBBBCCCCD 1 CompanionChase(NULL,NULL,CHF_FASTCHASE);
		TNT1 A 0 A_StartSound ("weapons/sshoto", CHAN_WEAPON);
		YOHN DDAAAABBBBCCC 1 CompanionChase(NULL,NULL,CHF_FASTCHASE);
		TNT1 A 0 A_StartSound ("weapons/sshotl", CHAN_WEAPON);
		YOHN CDDDDAAAABBBB 1 CompanionChase(NULL,NULL,CHF_FASTCHASE);
