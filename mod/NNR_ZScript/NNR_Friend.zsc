	Pain:
		YOHN G 2 CompanionVelocity(random(2,10), random(-10,10), random(1,2),CVF_RELATIVE);
		YOHN G 2 Fast
		{
			if (!IsCarmack() || level.time >= VoiceUntil) A_Pain();
			CompanionVelocity(random(2,10), random(-10,10), random(1,2),CVF_RELATIVE);
		}
		TNT1 A 0 CompanionVelocity(random(1,4), random(-5,5), random(1,2),CVF_RELATIVE);
		Goto See;
	FakeDeath:
		TNT1 A 0 
		{
			bSHOOTABLE = false;
		}
		YOHN I 5;
		TNT1 A 0 A_RomeroVoice("yohn/Death", CHAN_VOICE, CHANF_DEFAULT, 1, ATTN_NONE);
		YOHN JKLM 5;
		YOHN N 100;
	FakeRaise:
		TNT1 A 0 
		{
			A_StartSound("FM/Raise", CHAN_BODY);
		}
		YOHN NMLKJI 5;
		TNT1 A 0
		{
			bSHOOTABLE = true;
		}
		Goto See;
