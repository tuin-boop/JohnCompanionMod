		YOHN F 2 Bright
		{
			A_FaceTarget();
			IdleTic = 0;
			A_StartSound("trident/fire", CHAN_WEAPON);
            LastWeaponCategory = 21;
			LastShotTime = level.time;
			A_SpawnProjectile("NNR_DKTridentProjectile");
			A_AlertMonsters(0, AMF_TARGETEMITTER);
		}
		YOHN E 2 A_FaceTarget;
		YOHN F 2 Bright
		{
			A_FaceTarget();
			A_StartSound("trident/fire", CHAN_WEAPON);
            LastWeaponCategory = 21;
			LastShotTime = level.time;
			A_SpawnProjectile("NNR_DKTridentProjectile");
		}
		YOHN E 2 A_FaceTarget;
		YOHN F 2 Bright
		{
			A_FaceTarget();
			A_StartSound("trident/fire", CHAN_WEAPON);
            LastWeaponCategory = 21;
			LastShotTime = level.time;
			A_SpawnProjectile("NNR_DKTridentProjectile");
