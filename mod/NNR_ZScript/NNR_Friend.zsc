		YOHN E 15;
		Goto See;
	Shotgun:
		TNT1 A 0 CompanionVelocity(random(2,10), random(-10,10), random(1,2),CVF_RELATIVE);
		YOHN E 1 A_FaceTarget;
		YOHN F 2 Bright
		{
			A_FaceTarget();
