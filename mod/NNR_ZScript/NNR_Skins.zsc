class OptionMenuItemJohnEra : OptionMenuItemStaticText
{
    String mPresentText;
    String mClassicText;
    String mCarmackText;
    OptionMenuItemJohnEra Init(String presentText, String classicText, String carmackText, int color = -1)
    {
        Super.Init(presentText, color);
        mPresentText = presentText;
        mClassicText = classicText;
        mCarmackText = carmackText;
        return self;
    }
    override int Draw(OptionMenuDescriptor desc, int y, int indent, bool selected)
    {
        int selectedSkin = CVar.FindCVar("blnk_companions").GetInt() == 1 ? (CVar.FindCVar("blnk_duocarmack").GetInt() == 2 ? 5 : CVar.FindCVar("blnk_duocarmack").GetInt() == 1 ? 4 : 2) : CVar.FindCVar("blnk_duoromero").GetInt();
        mLabel = selectedSkin == 1 ? mClassicText : mPresentText;
        if (selectedSkin == 2)
        {
            mLabel = mCarmackText;
            if (mCarmackText == "Romero tips and voice lines are off.") mLabel = "Interview recordings, with room to breathe.";
        }
        if (selectedSkin == 3)
        {
            if (mCarmackText == "Young Carmack") mLabel = "John Romero 2005";
            else if (mCarmackText == "Romero tips and voice lines are off.") mLabel = "Another chapter in Romero's story.";
            else mLabel = "Long black hair, stripes, and silver pendant.";
        }
        if (selectedSkin == 4)
        {
            if (mCarmackText == "Young Carmack") mLabel = "John Carmack 2006";
            else if (mCarmackText == "Romero tips and voice lines are off.") mLabel = "The era of your interview recordings.";
            else mLabel = "Black polo, light brown hair, wire glasses.";
        }
        if (CVar.FindCVar("blnk_companions").GetInt() == 2)
        {
            if (mCarmackText == "Young Carmack") mLabel = "Romero and Carmack";
            else if (mCarmackText == "Romero tips and voice lines are off.") mLabel = "Both voices, taking turns.";
            else mLabel = "Two companions, with separate kill counts.";
        }
        return Super.Draw(desc, y, indent, selected);
    }
}

// Register the alternate sprite prefix at load time. Actual companion states
// keep their original timing and switch only their displayed sprite index.
class NNR_ClassicJohnSpriteRegistry : Actor
{
    States
    {
    Spawn:
        JCLS ABCDEFGIJKLMN -1;
        Stop;
    }
}

class NNR_CarmackSpriteRegistry : Actor { States { Spawn: JCMA ABCDEFGIJKLMN -1; Stop; } }

class NNR_Romero2005Registry : Actor { States { Spawn: JR05 ABCDEFGIJKLMN -1; Stop; } }

class NNR_Carmack2006Registry : Actor { States { Spawn: JC06 ABCDEFGIJKLMN -1; Stop; } }

class NNR_CompanionPreviewMenu : OptionMenu
{
    int PreviewTics;
    override void Init(Menu parent, OptionMenuDescriptor desc)
    {

        let mode = CVar.FindCVar("blnk_companions");
        if (mode.GetInt() < 0)
        {
            int oldSkin = CVar.FindCVar("blnk_bodyskin").GetInt();
            bool oldBoth = CVar.FindCVar("blnk_both").GetBool();
            if (!oldBoth)
            {
                if (oldSkin == 2 || (oldSkin == 4 || oldSkin == 5)) CVar.FindCVar("blnk_duocarmack").SetInt((oldSkin == 4 || oldSkin == 5) ? 1 : 0);
                else CVar.FindCVar("blnk_duoromero").SetInt(oldSkin);
            }
            mode.SetInt(oldBoth ? 2 : (oldSkin == 2 || (oldSkin == 4 || oldSkin == 5)) ? 1 : 0);
        }

        Super.Init(parent, desc);
    }
    override void Ticker()
    {
        Super.Ticker();
        PreviewTics++;
    }
    void DrawSkin(int skin, int center, bool following)
    {
        String prefix = "YOHN";
        String label = "Present-day Romero";
        switch (skin)
        {
        case 1: prefix="JCLS"; label="Daikatana-era Romero"; break;
        case 2: prefix="JCMA"; label="Young Carmack"; break;
        case 3: prefix="JR05"; label="John Romero 2005"; break;
        case 4: prefix="JC06"; label="John Carmack 2006"; break;
        }
        String frame = "A";
        switch ((PreviewTics / 7) % 4)
        {
        case 1: frame="B"; break;
        case 2: frame="C"; break;
        case 3: frame="D"; break;
        }
        TextureID tex = TexMan.CheckForTexture(String.Format("%s%s8", prefix, frame), TexMan.Type_Sprite);
        if (tex.IsValid())
        {
            Vector2 size = TexMan.GetScaledSize(tex);
            double height = 84;
            double width = height * size.X / Max(1., size.Y);
            Screen.DrawTexture(tex, false, center - width/2, 216,
                DTA_DestWidth, int(width), DTA_DestHeight, int(height),
                DTA_LeftOffset, 0, DTA_TopOffset, 0,
                DTA_VirtualWidth, 640, DTA_VirtualHeight, 360, DTA_KeepRatio, true);
        }
        Screen.DrawText(SmallFont, Font.CR_GOLD, center - SmallFont.StringWidth(label)/2, 308, label,
            DTA_VirtualWidth, 640, DTA_VirtualHeight, 360, DTA_KeepRatio, true);
        String status = following ? "Following you" : "Not following";
        Screen.DrawText(SmallFont, following ? Font.CR_GREEN : Font.CR_GRAY, center - SmallFont.StringWidth(status)/2, 322, status,
            DTA_VirtualWidth, 640, DTA_VirtualHeight, 360, DTA_KeepRatio, true);
    }
    override void Drawer()
    {
        Super.Drawer();
        int mode = CVar.FindCVar("blnk_companions").GetInt();
        DrawSkin(CVar.FindCVar("blnk_duoromero").GetInt(), 236, mode != 1);
        DrawSkin(CVar.FindCVar("blnk_duocarmack").GetInt() == 2 ? 5 : CVar.FindCVar("blnk_duocarmack").GetInt() == 1 ? 4 : 2, 404, mode != 0);
    }
}

class NNR_FollowNotice : EventHandler
{
 int RomeroCampReady[MAXPLAYERS];int CarmackCampReady[MAXPLAYERS];
 String notice;int noticePlayer;
 int noticeUntil;bool closeMode;bool initialized;
 override void NetworkProcess(ConsoleEvent e)
 {
  if(e.Name=="nnr_campro" || e.Name=="nnr_campca")
  {
   if(level.MapName=="TITLEMAP" || e.Player<0 || e.Player>=MAXPLAYERS)return;
   let pl=players[e.Player].mo;if(!pl || pl.health<=0)return;
   bool carmack=e.Name=="nnr_campca";
   let it=ThinkerIterator.Create("NNR_JohnMarine");NNR_JohnMarine john;bool found=false;
   while((john=NNR_JohnMarine(it.Next()))!=null)
   {
    if(john.master!=pl || john.IsCarmack()!=carmack)continue;
    found=true;
    int ready=carmack?CarmackCampReady[e.Player]:RomeroCampReady[e.Player];
    if(level.time<ready)notice=String.Format("%s: CAMP READY IN %d SEC",carmack?"CARMACK":"ROMERO",(ready-level.time+34)/35);
    else if(john.CampHere(pl))
    {
     if(carmack)CarmackCampReady[e.Player]=level.time+350;else RomeroCampReady[e.Player]=level.time+350;
     notice=String.Format("%s: CAMP SET - 10 SEC COOLDOWN",carmack?"CARMACK":"ROMERO");
    }
    else notice="NO ROOM TO TELEPORT HERE";
    break;
   }
   if(!found)notice=String.Format("%s IS NOT IN YOUR TEAM",carmack?"CARMACK":"ROMERO");
   noticePlayer=e.Player;noticeUntil=level.time+105;return;
  }
  if(e.Name=="nnr_closefollow")
  {
   let it=ThinkerIterator.Create("NNR_JohnMarine");NNR_JohnMarine john;
   while((john=NNR_JohnMarine(it.Next()))!=null)
    if(e.Player>=0 && e.Player<MAXPLAYERS && john.master==players[e.Player].mo)john.Camping=false;
   let c=CVar.FindCVar("blnk_closefollow");c.SetInt(c.GetInt()==0?1:0);
  }
 }
 override void WorldTick()
 {
  bool now=CVar.FindCVar("blnk_closefollow").GetInt()!=0;
  if(initialized && now!=closeMode){noticeUntil=level.time+105;notice=now?"CLOSE: STAY WITH ME":"NORMAL FOLLOWING";noticePlayer=-1;}
  closeMode=now;initialized=true;
 }
 override void RenderOverlay(RenderEvent e)
 {
  if(level.MapName=="TITLEMAP")return;
  if(level.time>=noticeUntil || Menu.GetCurrentMenu()!=null)return;
  if(noticePlayer>=0 && noticePlayer!=consoleplayer)return;
  String msg=notice;
  let font=Font.GetFont("TINYBABY");
  double scale=2.0;
  Screen.DrawText(font,Font.CR_CYAN,320-font.StringWidth(msg)*scale/2,318,msg,DTA_VirtualWidth,640,DTA_VirtualHeight,360,DTA_ScaleX,scale,DTA_ScaleY,scale);
 }
}

class NNR_StyledCompanionMenu : NNR_CompanionPreviewMenu
{
    int choice;
    int pressedChoice;
    bool hasDrawn;
    int lastMouseX, lastMouseY;
    double uiScale,px,py;
    override void Init(Menu parent,OptionMenuDescriptor desc)
    {
        Super.Init(parent,desc);
        choice=0;pressedChoice=-1;lastMouseX=-9999;lastMouseY=-9999;
        menuactive=Menu.On;
    }
    void Layout()
    {
        uiScale=min((Screen.GetWidth()-32)/1000.0,(Screen.GetHeight()-32)/690.0);
        uiScale=min(uiScale,1.8);
        px=(Screen.GetWidth()-1000*uiScale)*.5;
        py=(Screen.GetHeight()-690*uiScale)*.5;
    }
    void Label(double x,double y,String text,int color=Font.CR_WHITE,double size=1.8)
    {
        Screen.DrawText("TINYBABY",color,px+x*uiScale,py+y*uiScale,text,DTA_ScaleX,size*uiScale,DTA_ScaleY,size*uiScale);
    }
    void Panel(double x,double y,double w,double h,bool selected=false)
    {
        Screen.Dim(selected?Color(11,43,76):Color(5,23,43),.98,int(px+x*uiScale),int(py+y*uiScale),int(w*uiScale),int(h*uiScale));
        Screen.DrawLineFrame(selected?Color(70,220,255):Color(26,68,105),int(px+x*uiScale),int(py+y*uiScale),int(w*uiScale),int(h*uiScale),selected?3:1);
    }
    int Value(String name) { return CVar.FindCVar(name).GetInt(); }
    String OnOff(String name) { return Value(name)!=0?"ON":"OFF"; }
    void SkinCard(bool carmack,double x,int index)
    {
        int skin=carmack?(Value("blnk_duocarmack")==2?5:Value("blnk_duocarmack")==1?4:2):Value("blnk_duoromero");
        String prefix="YOHN",title="PRESENT-DAY ROMERO",detail="Gray hair, glasses, decades of Doom.";
        switch(skin)
        {
        case 1: prefix="JCLS";title="DAIKATANA-ERA ROMERO";detail="Black shirt and long hair. The 2000 era.";break;
        case 2: prefix="JCMA";title="YOUNG CARMACK";detail="Blue shirt and early id days.";break;
        case 3: prefix="JR05";title="JOHN ROMERO 2005";detail="Striped shirt and silver pendant.";break;
        case 5: prefix="SWMK";title="SWOLEMACK";detail="Silver hair, black tee, and stronger arms.";break;
        case 4: prefix="JC06";title="JOHN CARMACK 2006";detail="Black polo and wire-frame glasses.";break;
        }
        bool active=carmack?Value("blnk_companions")!=0:Value("blnk_companions")!=1;
        bool camping=false;
        let it=ThinkerIterator.Create("NNR_JohnMarine");NNR_JohnMarine john;
        while((john=NNR_JohnMarine(it.Next()))!=null)
            if(john.master==players[consoleplayer].mo && ((john is "NNR_CarmackMarine") || Value("blnk_companions")==1)==carmack && john.Camping)camping=true;
        Panel(x,116,468,208,choice==index);
        Label(x+16,130,carmack?"CARMACK SKIN":"ROMERO SKIN",Font.CR_LIGHTBLUE,1.6);
        Label(x+16,151,title,Font.CR_WHITE,1.8);
        Label(x+16,179,detail,Font.CR_GRAY,1.3);
        Label(x+16,221,active?(camping?"HOLDING CAMP":"FOLLOWING YOU"):"NOT FOLLOWING",active?Font.CR_GREEN:Font.CR_GRAY,1.6);
        Label(x+16,293,"<  CHANGE SKIN  >",choice==index?Font.CR_CYAN:Font.CR_GRAY,1.5);
        String frame="A";
        switch((PreviewTics/7)%4) { case 1:frame="B";break;case 2:frame="C";break;case 3:frame="D";break; }
        TextureID tex=TexMan.CheckForTexture(String.Format("%s%s8",prefix,frame),TexMan.Type_Sprite);
        if(tex.IsValid())
        {
            Vector2 size=TexMan.GetScaledSize(tex);
            double h=114,w=h*size.X/Max(1.,size.Y);
            Screen.DrawTexture(tex,false,px+(x+378-w/2)*uiScale,py+200*uiScale,
                DTA_DestWidth,int(w*uiScale),DTA_DestHeight,int(h*uiScale),DTA_LeftOffset,0,DTA_TopOffset,0);
        }
    }
    override void Drawer()
    {
        Layout();hasDrawn=true;
        Screen.Dim(Color(3,13,31),.98,int(px),int(py),int(1000*uiScale),int(690*uiScale));
        Screen.DrawLineFrame(Color(36,128,210),int(px),int(py),int(1000*uiScale),int(690*uiScale),3);
        Label(24,22,"COMPANION CONTROL",Font.CR_WHITE,3.0);
        Label(760,31,"ROMERO + CARMACK",Font.CR_LIGHTBLUE,1.6);
        Panel(24,70,952,34,choice==0);
        Label(38,79,"COMPANIONS",Font.CR_LIGHTBLUE,1.7);
        int mode=Value("blnk_companions");
        Label(450,79,mode==0?"<  ROMERO ONLY  >":mode==1?"<  CARMACK ONLY  >":"<  BOTH  >",Font.CR_CYAN,1.8);
        SkinCard(false,24,1);SkinCard(true,508,2);
        static const String labels[]={"ROMERO HUD PORTRAIT","WEAPON SET","LEVEL TALLY","ROMERO GAME FACTS","CARMACK INTERVIEWS","CARMACK PAUSE","ROMERO IDLE CHAT","FOLLOW DISTANCE","CLOSE PANEL"};
        for(int i=0;i<9;i++)
        {
            int index=i+3;double x=24+(i%2)*484,y=340+(i/2)*62;
            Panel(x,y,468,52,choice==index);
            Label(x+14,y+8,labels[i],Font.CR_LIGHTBLUE,1.5);
            String value;
            switch(index)
            {
            case 3:value=Value("blnk_hudstyle")==0?"GLASSES ROMERO":"CLASSIC ROMERO";break;
            case 4:value=Value("blnk_weaponstyle")==0?"DAIKATANA":"CLASSIC DOOM";break;
            case 5:value=OnOff("blnk_intermission");break;
            case 6:value=OnOff("blnk_mapfacts");break;
            case 7:value=OnOff("blnk_carmackvoice");break;
            case 8:value=String.Format("%d SECONDS AFTER CLIP",Value("blnk_carmackpause"));break;
            case 9:value=String.Format("%d TICS",Value("blnk_idletalk"));break;
            case 10:value=Value("blnk_closefollow")!=0?"CLOSE - STAY NEAR ME":"NORMAL - ORIGINAL DISTANCE";break;
            case 11:value="RETURN TO GAME";break;
            }
            Label(x+14,y+29,value,choice==index?Font.CR_CYAN:Font.CR_WHITE,1.8);
        }
        Label(24,641,"ARROWS: SELECT / CHANGE    ENTER / CLICK: CHANGE    ESC: BACK",Font.CR_GRAY,1.6);
        Label(24,660,"K / L: TELEPORT + CAMP (10 SEC)    F7: FOLLOW - CLOSE / NORMAL",Font.CR_GRAY,1.3);
    }
    void Change(int direction)
    {
        if(choice==11) { Close();return; }
        String key;int step=1,lo=0,hi=1;
        switch(choice)
        {
        case 0:key="blnk_companions";hi=2;break;
        case 1:
            int skin=Value("blnk_duoromero");
            int pos=skin==3?2:skin;
            pos=(pos+direction+3)%3;
            CVar.FindCVar("blnk_duoromero").SetInt(pos==2?3:pos);
            MenuSound("menu/change");return;
        case 2:key="blnk_duocarmack";hi=2;break;
        case 3:key="blnk_hudstyle";break;
        case 4:key="blnk_weaponstyle";break;
        case 5:key="blnk_intermission";break;
        case 6:key="blnk_mapfacts";break;
        case 7:key="blnk_carmackvoice";break;
        case 8:key="blnk_carmackpause";lo=60;hi=600;step=30;break;
        case 10:key="blnk_closefollow";break;
        case 9:key="blnk_idletalk";lo=500;hi=2000;step=50;break;
        }
        int value=Value(key)+direction*step;
        if(step==1) { if(value>hi)value=lo;if(value<lo)value=hi; }
        else value=Clamp(value,lo,hi);
        CVar.FindCVar(key).SetInt(value);
        MenuSound("menu/change");
    }
    override bool TranslateKeyboardEvents() { return false; }
    override bool OnUIEvent(UiEvent ev)
    {
        if(ev.Type==UiEvent.Type_KeyUp || ev.Type==UiEvent.Type_KeyRepeat || ev.Type==UiEvent.Type_Char) return true;
        if(ev.Type==UiEvent.Type_KeyDown)
        {
            if(ev.KeyChar==UiEvent.Key_Escape) return MenuEvent(MKEY_Back,false);
            if(ev.KeyChar==UiEvent.Key_Down) return MenuEvent(MKEY_Down,false);
            if(ev.KeyChar==UiEvent.Key_Up) return MenuEvent(MKEY_Up,false);
            if(ev.KeyChar==UiEvent.Key_Left) return MenuEvent(MKEY_Left,false);
            if(ev.KeyChar==UiEvent.Key_Right) return MenuEvent(MKEY_Right,false);
            if(ev.KeyChar==UiEvent.Key_Return) return MenuEvent(MKEY_Enter,false);
        }
        return Super.OnUIEvent(ev);
    }
    override bool MenuEvent(int key,bool controller)
    {
        if(key==MKEY_Back) return Super.MenuEvent(key,controller);
        if(key==MKEY_Down)choice=(choice+1)%12;
        else if(key==MKEY_Up)choice=(choice+11)%12;
        else if(key==MKEY_Left)Change(-1);
        else if(key==MKEY_Right || key==MKEY_Enter)Change(1);
        else return false;
        return true;
    }
    override bool MouseEvent(int type,int x,int y)
    {
        if(!hasDrawn)return true;
        if(type==MOUSE_Move && lastMouseX==-9999) { lastMouseX=x;lastMouseY=y;return true; }
        if(type==MOUSE_Move && x==lastMouseX && y==lastMouseY)return true;
        lastMouseX=x;lastMouseY=y;Layout();
        double mx=(x-px)/uiScale,my=(y-py)/uiScale;
        int hit=-1;
        if(mx>=24 && mx<976 && my>=70 && my<104)hit=0;
        if(my>=116 && my<324) { if(mx>=24 && mx<492)hit=1;else if(mx>=508 && mx<976)hit=2; }
        for(int i=0;i<9;i++)
        {
            double cx=24+(i%2)*484,cy=340+(i/2)*62;
            if(mx>=cx && mx<cx+468 && my>=cy && my<cy+52)hit=i+3;
        }
        if(type==MOUSE_Click) { pressedChoice=hit;if(hit>=0)choice=hit; }
        else if(type==MOUSE_Release) { if(hit>=0 && hit==pressedChoice){choice=hit;Change(1);}pressedChoice=-1; }
        else if(type==MOUSE_Move && hit>=0)choice=hit;
        return true;
    }
}


