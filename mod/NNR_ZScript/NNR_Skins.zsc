class NNR_HellTitle : EventHandler
{
 Actor camera;Actor lineup[5];
 override void WorldTick()
 {
  if(level.MapName!="TITLEMAP")return;
  if(!camera)camera=Actor.Spawn("NNR_TitleCamera",(0,-220,74));
  static const String kinds[]={"NNR_TitleRomero","NNR_TitleCarmack","NNR_TitleJay","NNR_TitleTom","NNR_TitleAdrian"};
  for(int i=0;i<5;i++){
   if(!lineup[i])lineup[i]=Actor.Spawn(kinds[i],((i-2)*80,72,24));
   if(lineup[i])lineup[i].angle=270;
  }
  // Sweep an arc around the lineup, always looking toward its center.
  double orbit=sin(level.time*.3)*18;
  camera.SetOrigin((sin(orbit)*292,72-cos(orbit)*292,74),false);
  camera.angle=VectorAngle(-camera.pos.X,72-camera.pos.Y);camera.pitch=5;
  if(players[0].mo)players[0].camera=camera;
 }
 override void RenderOverlay(RenderEvent e)
 {
  if(level.MapName!="TITLEMAP")return;
  let f=Font.GetFont("TINYBABY");
  String title="CREATORS AT YOUR SIDE";
  Screen.DrawText(f,Font.CR_GOLD,320-f.StringWidth(title)*1.5,26,title,DTA_VirtualWidth,640,DTA_VirtualHeight,360,DTA_ScaleX,3.0,DTA_ScaleY,3.0);
  String sub="CHOOSE YOUR TEAM. TAKE ON HELL.";
  Screen.DrawText(f,Font.CR_WHITE,320-f.StringWidth(sub),52,sub,DTA_VirtualWidth,640,DTA_VirtualHeight,360,DTA_ScaleX,2.0,DTA_ScaleY,2.0);
  int mask=NNR_Team.Mask(CVar.FindCVar("blnk_companions").GetInt());
  for(int i=0;i<5;i++){
   bool active=(mask&(1<<i))!=0;String status=active?"ENABLED":"DISABLED";
   // Project the feet using the rendered camera, including its interpolated yaw.
   Vector3 delta=((i-2)*80,72,24)-e.ViewPos;
   double forward=delta.X*cos(e.ViewAngle)+delta.Y*sin(e.ViewAngle);
   double side=delta.X*sin(e.ViewAngle)-delta.Y*cos(e.ViewAngle);
   double depth=Max(1.,forward*cos(e.ViewPitch)-delta.Z*sin(e.ViewPitch));
   double up=delta.Z*cos(e.ViewPitch)+forward*sin(e.ViewPitch);
   double fovScale=1./tan(Clamp(players[consoleplayer].FOV,30.,140.)*.5);
   double center=320+side/depth*(800./3.)*fovScale;
   double bottom=180-up/depth*320*fovScale+12;
   Screen.DrawText(f,active?Font.CR_GREEN:Font.CR_GRAY,center-f.StringWidth(status)*.6,bottom,status,DTA_VirtualWidth,640,DTA_VirtualHeight,360,DTA_ScaleX,1.2,DTA_ScaleY,1.2,DTA_KeepRatio,true);
  }
  if(Menu.GetCurrentMenu()==null)
  {
   String hint="PRESS ESC TO BEGIN";
   Screen.DrawText(f,Font.CR_GOLD,320-f.StringWidth(hint),328,hint,DTA_VirtualWidth,640,DTA_VirtualHeight,360,DTA_ScaleX,2.0,DTA_ScaleY,2.0);
  }
 }
}

