{
 Default { +NOGRAVITY;+NOCLIP; }
 States { Spawn: TNT1 A -1;Stop; }
}
class NNR_HellTitle : EventHandler
{
 Actor camera;Actor jay;
 override void WorldTick()
 {
  if(level.MapName!="TITLEMAP")return;
  if(!camera)
  {
   camera=Actor.Spawn("NNR_TitleCamera",(0,-250,74));
   let r=Actor.Spawn("NNR_TitleRomero",(-48,72,24));r.angle=295;
   let c=Actor.Spawn("NNR_TitleCarmack",(48,72,24));c.angle=245;
  }
  CVar.FindCVar("blnk_jay").SetBool(CVar.FindCVar("blnk_companions").GetInt()>=3 && CVar.FindCVar("blnk_companions").GetInt()<=5);
  if(CVar.FindCVar("blnk_jay").GetBool() && !jay){jay=Actor.Spawn("NNR_TitleJay",(CVar.FindCVar("blnk_companions").GetInt()==5?-48:48,72,24));jay.angle=270;}
  if(!CVar.FindCVar("blnk_jay").GetBool() && jay){jay.Destroy();jay=null;}
  if(jay)jay.SetOrigin((CVar.FindCVar("blnk_companions").GetInt()==3?0:CVar.FindCVar("blnk_companions").GetInt()==5?-48:48,72,24),false);
  double t=level.time*.12;
  camera.SetOrigin((sin(t)*30,-160+cos(t)*12,65+sin(t*.6)*3),false);
  camera.angle=VectorAngle(-camera.pos.X,72-camera.pos.Y);
  camera.pitch=5;
  if(players[0].mo)players[0].camera=camera;
 }
 override void RenderOverlay(RenderEvent e)
 {
  if(level.MapName!="TITLEMAP")return;
  let f=Font.GetFont("TINYBABY");
  String title="CREATORS AT YOUR SIDE";
  Screen.DrawText(f,Font.CR_GOLD,320-f.StringWidth(title)*1.5,26,title,DTA_VirtualWidth,640,DTA_VirtualHeight,360,DTA_ScaleX,3.0,DTA_ScaleY,3.0);
  String sub="CHOOSE YOUR TEAM. TAKE ON HELL.";
  Screen.DrawText(f,Font.CR_WHITE,320-f.StringWidth(sub),52,sub,DTA_VirtualWidth,640,DTA_VirtualHeight,360,DTA_ScaleX,2.0,DTA_ScaleY,2.0);
  if(Menu.GetCurrentMenu()==null)
  {
   String hint="PRESS ESC TO BEGIN";
   Screen.DrawText(f,Font.CR_GOLD,320-f.StringWidth(hint),328,hint,DTA_VirtualWidth,640,DTA_VirtualHeight,360,DTA_ScaleX,2.0,DTA_ScaleY,2.0);
  }
 }
}

