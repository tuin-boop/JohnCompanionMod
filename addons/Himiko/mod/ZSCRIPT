class NNR_HimikoMenu : NNR_StyledCompanionMenu {
 int selected;
 int Current(){return 6+selected;}
 String Prefix(){return selected==7?"ERNI":selected==6?"KUMI":selected==5?"ESTH":selected==4?"TUIN":selected==3?"FRIR":selected==2?"KARN":selected==1?"TINA":"HIMK";}
 void Browse(int delta){selected=(selected+delta+8)%8;MenuSound("menu/change");}
 void Apply(int delta){
  if(choice==2){Browse(delta);return;}
  if(choice==0){ToggleMember(1<<(Current()-1));return;}
  int member=NNR_Team.Slot(Value("blnk_companions"),choice==1?0:1);
  if(member)ToggleMember(1<<(member-1));
 }
 void TeamSlot(int slot){
  int member=NNR_Team.Slot(Value("blnk_companions"),slot);double y=184+slot*154;
  Panel(508,y,448,138);
  Label(526,y+14,slot==0?"SLOT 1  /  K":"SLOT 2  /  L",Font.CR_GRAY,1.35);
  if(member){
   let face=TexMan.CheckForTexture(NNR_Team.Face(member,1,true),TexMan.Type_Any);
   Screen.DrawTexture(face,false,px+526*uiScale,py+(y+43)*uiScale,DTA_DestWidth,int(60*uiScale),DTA_DestHeight,int(65*uiScale),DTA_LeftOffset,0,DTA_TopOffset,0);
   Label(606,y+43,NNR_Team.Name(member),Font.CR_GREEN,1.9);
   Panel(606,y+80,320,38,choice==(slot==0?1:3));Label(622,y+91,"REMOVE FROM TEAM",Font.CR_CYAN,1.5);
  }else Label(526,y+64,"EMPTY - ADD A COMPANION",Font.CR_GRAY,1.65);
 }
 override void Drawer(){
  Layout();hasDrawn=true;int mode=Value("blnk_companions");int mask=NNR_Team.Mask(mode);
  bool active=(mask&(1<<(Current()-1)))!=0;int count=(NNR_Team.Slot(mode,0)!=0)+(NNR_Team.Slot(mode,1)!=0);
  Screen.Dim(Color(2,9,21),.98,int(px),int(py),int(1000*uiScale),int(690*uiScale));
  Label(24,24,"EXTRA COMPANIONS",Font.CR_WHITE,2.8);
  Label(24,70,"BROWSE A CHARACTER, THEN ADD TO YOUR TEAM",Font.CR_CYAN,1.6);
  Panel(24,114,440,480);
  Label(48,132,"BROWSE CHARACTERS",Font.CR_GRAY,1.4);
  Panel(48,164,44,42,choice==2);Label(62,177,"<",Font.CR_CYAN,2);
  Panel(396,164,44,42,choice==2);Label(410,177,">",Font.CR_CYAN,2);
  Label(112,175,NNR_Team.Name(Current()),Font.CR_WHITE,2.4);
  Label(340,140,String.Format("%d / 8",selected+1),Font.CR_GRAY,1.35);
  String pose=PreviewTics%28<7?"A":PreviewTics%28<14?"B":PreviewTics%28<21?"C":"D";
  let pic=TexMan.CheckForTexture(Prefix()..pose.."8",TexMan.Type_Sprite);
  Screen.DrawTexture(pic,false,px+205*uiScale,py+220*uiScale,DTA_DestWidth,int(160*uiScale),DTA_DestHeight,int(220*uiScale),DTA_LeftOffset,0,DTA_TopOffset,0);
  Label(48,465,active?"IN YOUR TEAM":"NOT IN YOUR TEAM",active?Font.CR_GREEN:Font.CR_GRAY,1.9);
  Panel(48,510,390,52,choice==0);Label(64,527,active?"REMOVE FROM TEAM":"ADD TO TEAM",Font.CR_CYAN,1.9);
  if(!active && count==2)Label(48,576,"TEAM FULL: REPLACES "..NNR_Team.Name(NNR_Team.Slot(mode,0)),Font.CR_GOLD,1.2);
  Panel(488,114,488,480);
  Label(512,138,String.Format("YOUR ACTIVE TEAM  %d / 2",count),Font.CR_WHITE,2);
  TeamSlot(0);TeamSlot(1);
  Label(512,514,"ONLY THESE COMPANIONS ARE ACTIVE",Font.CR_GRAY,1.35);
  if(PreviewTics<teamNoticeUntil)Label(512,556,teamNotice,Font.CR_GOLD,1.15);
  Label(24,626,"LEFT / RIGHT: BROWSE   ENTER: SELECT",Font.CR_GRAY,1.5);
  Label(24,662,"ESC: BACK    K / L: CAMP    F7: FOLLOW",Font.CR_CYAN,1.4);
 }
 override bool MenuEvent(int key,bool controller){
  if(key==MKEY_Back)return Super.MenuEvent(key,controller);
  if(key==MKEY_Left){Browse(-1);return true;}
  if(key==MKEY_Right){Browse(1);return true;}
  if(key==MKEY_Up || key==MKEY_Down){choice=(choice+(key==MKEY_Down?1:3))%4;return true;}
  if(key==MKEY_Enter){Apply(1);return true;}return false;
 }
 override bool MouseEvent(int type,int x,int y){
  if(!hasDrawn)return true;Layout();double mx=(x-px)/uiScale,my=(y-py)/uiScale;
  int hit=mx>=48 && mx<440 && my>=164 && my<206 && (mx<92 || mx>=396)?2:mx>=48 && mx<438 && my>=510 && my<562?0:mx>=606 && mx<926 && my>=264 && my<302?1:mx>=606 && mx<926 && my>=418 && my<456?3:-1;
  if(type==MOUSE_Click){pressedChoice=hit;if(hit>=0)choice=hit;}
  else if(type==MOUSE_Release){if(hit>=0 && hit==pressedChoice){choice=hit;Apply(hit==2 && mx<92?-1:1);}pressedChoice=-1;}
  else if(type==MOUSE_Move && hit>=0)choice=hit;return true;
 }
}

